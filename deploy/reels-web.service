[Unit]
Description=GO POST web
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/reels-autoposter
Environment=NODE_ENV=production
Environment=DATA_DIR=/opt/reels-autoposter/data
Environment=TZ=America/Sao_Paulo
EnvironmentFile=-/opt/reels-autoposter/.env
EnvironmentFile=-/opt/reels-autoposter/.env.local
ExecStart=/usr/bin/node /opt/reels-autoposter/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/reels-autoposter/data /opt/reels-autoposter/.next/cache

[Install]
WantedBy=multi-user.target
