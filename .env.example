# URL canônica; HTTPS é obrigatório em produção
APP_URL=http://localhost:3000

# Login Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Administradores e membros PRO, separados por vírgula
ADMIN_EMAIL=admin@localhost
PRO_EMAILS=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Criptografia opcional dos tokens no SQLite.
# Gere uma chave longa e estável; não a altere depois sem uma migração planejada.
SETTINGS_ENCRYPTION_KEY=

# Integrações opcionais
APIFY_TOKEN=
APIFY_ACTOR=apify/instagram-scraper
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fallback yt-dlp opcional
COOKIES_FILE=
COOKIES_BROWSER=

# Pipeline
CRON_SCHEDULE=*/30 * * * *
MAX_REELS_PER_RUN=5
DISCOVERY_LIMIT=10
DISCOVERY_INTERVAL_MINUTES=360
PUBLISH_INTERVAL_MINUTES=30
LOGO_POSITION=bottom-right
LOGO_SCALE=80
