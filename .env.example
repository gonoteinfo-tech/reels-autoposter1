# Copy to .env.local; keep the existing application's OAuth values.
APP_URL=https://seu-dominio.com.br
ADMIN_EMAIL=seu-email@example.com
DATA_DIR=/opt/reels-autoposter/data
TZ=America/Sao_Paulo

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_GRAPH_VERSION=v26.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only user #1 can use these legacy defaults; other users select their page via OAuth.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

BRIGHTDATA_API_TOKEN=
BRIGHTDATA_REELS_DATASET=gd_lyclm20il4r5helnj
BRIGHTDATA_FACEBOOK_REELS_DATASET=gd_lyclm3ey2q6rww027t

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_CAPTION_TIMEOUT_MS=30000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://videos.seu-dominio.com.br

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
YTDLP_PATH=/usr/local/bin/yt-dlp
# Optional for individual Facebook/TikTok/YouTube downloads; not used for Bright Data profile discovery.
COOKIES_FILE=
MAX_VIDEO_BYTES=536870912
MAX_VIDEO_SECONDS=900
MIN_FREE_DISK_BYTES=1073741824
FFMPEG_TIMEOUT_MS=600000
FFMPEG_THREADS=2
# Only seeds defaults; ongoing per-user schedules are configured in the dashboard.
CRON_SCHEDULE=*/30 * * * *
